PORT=3000
# Public URL guests open (used inside WhatsApp invite links)
BASE_URL=https://rsvp.candiddulhan.com
ADMIN_PASSWORD=change-me
# Optional: separate password for the calling team (caller console only)
CALLER_PASSWORD=
# Key the Android phone uses to upload call recordings (long random string)
API_KEY=
# Long random string; keeps logins valid across restarts
SESSION_SECRET=
DATA_DIR=./data
MAX_UPLOAD_MB=25
# AI features (optional): key from console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# ID documents are encrypted with this key (any long random string). Keep it safe — without it IDs can't be opened.
ID_ENCRYPTION_KEY=
# WhatsApp Business (Meta Cloud API). Leave empty for test mode.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_TEMPLATE_LANG=en
# service = partner companies can bulk-send only on weddings using your RSVP desk; all = everyone
# WHATSAPP_PARTNER_ACCESS=service
# AUTOMATION_INTERVAL_MIN=10
